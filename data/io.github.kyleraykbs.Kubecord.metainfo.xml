  <name>Kubecord</name>
  <summary>Chat, talk and stream on Discord</summary>

  <developer id="io.github.kyleraykbs">
    <name>kyleraykbs</name>
  </developer>

  <description>
    <p>
      Kubecord is a native client for Discord, written in Rust with GTK and
      libadwaita. It is not made by or affiliated with Discord.
    </p>
    <p>Features:</p>
    <ul>
      <li>Voice and video calls, with screen sharing that includes audio</li>
      <li>Text chat with images, videos, GIFs, emoji, stickers and embeds</li>
      <li>Slash commands, buttons, menus and forms from apps and bots</li>
      <li>A local log of deleted and edited messages</li>
      <li>Export a range of messages as a picture or as text</li>
      <li>Multiple accounts</li>
      <li>Follows your system colors, or uses Discord's own look</li>
    </ul>
    <p>
      Note: third-party clients are against Discord's Terms of Service and
      can, rarely, lead to an account being banned.
    </p>
  </description>

  <launchable type="desktop-id">io.github.kyleraykbs.Kubecord.desktop</launchable>
  <provides>
    <binary>kubecord</binary>
  </provides>

